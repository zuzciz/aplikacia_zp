<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/log_reg_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nový tréning"
            android:textColor="@color/title"
            android:textStyle="bold"
            android:textSize="30dp"
            android:fontFamily="@font/poppins_bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dátum:"
            android:textStyle="bold"
            android:fontFamily="@font/poppins" />

        <EditText
            android:id="@+id/etDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Dátum (dd.MM.yyyy)"
            android:focusable="false"
            android:textColor="#000000"
            android:layout_marginBottom="12dp"
            android:background="@color/white"
            android:padding="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Typ tréningu:"
            android:textStyle="bold"
            android:fontFamily="@font/poppins" />

        <Spinner
            android:id="@+id/spinnerType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:padding="4dp"
            android:background="@drawable/rounded_white_background" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trvanie (min):"
            android:textStyle="bold"
            android:fontFamily="@font/poppins" />

        <EditText
            android:id="@+id/etDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="napr. 90"
            android:inputType="number"
            android:maxLength="3"
            android:textColor="#000000"
            android:layout_marginBottom="12dp"
            android:background="@color/white"
            android:padding="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vzdialenosť (m), nepovinné:"
            android:textStyle="bold"
            android:fontFamily="@font/poppins" />

        <EditText
            android:id="@+id/etDistance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="napr. 3000"
            android:inputType="number"
            android:maxLength="6"
            android:textColor="#000000"
            android:layout_marginBottom="12dp"
            android:background="@color/white"
            android:padding="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Námaha RPE (1 – 10):"
            android:textStyle="bold"
            android:fontFamily="@font/poppins" />

        <EditText
            android:id="@+id/etRpe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="1 = veľmi ľahko, 10 = maximum"
            android:inputType="number"
            android:maxLength="2"
            android:textColor="#000000"
            android:layout_marginBottom="6dp"
            android:background="@color/white"
            android:padding="4dp" />

        <TextView
            android:id="@+id/tvLoadPreview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Záťaž: –"
            android:textStyle="bold"
            android:fontFamily="@font/poppins"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Poznámka:"
            android:textStyle="bold"
            android:fontFamily="@font/poppins" />

        <EditText
            android:id="@+id/etNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="nepovinné"
            android:inputType="textCapSentences|textMultiLine"
            android:textColor="#000000"
            android:layout_marginBottom="12dp"
            android:background="@color/white"
            android:padding="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Uložiť"
            android:backgroundTint="@color/dark_background"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:cornerRadius="24dp"
            android:fontFamily="@font/poppins" />
    </LinearLayout>
</ScrollView>