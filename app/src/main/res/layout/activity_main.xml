<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".MainActivity"
    android:background="@color/light_background">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline25"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="10dp" />

    <LinearLayout
        android:id="@+id/llPool"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="@drawable/main_container"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toBottomOf="@id/guideline25"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/toggleGroupPoolLengthLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bazén"
            android:textStyle="bold"
            android:textSize="16dp"
            android:textColor="@color/white"
            android:fontFamily="@font/poppins" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleGroupPoolLength"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button25m"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:text="25m"
                android:textStyle="bold"
                android:textColor="@drawable/toggle_button_text"
                android:backgroundTint="@drawable/toggle_button_background"
                android:fontFamily="@font/poppins"
                app:cornerRadius="24dp"
                app:strokeColor="@color/dark_background"
                app:strokeWidth="2dp"
                app:rippleColor="@color/light_background"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button50m"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:text="50m"
                android:textStyle="bold"
                android:textColor="@drawable/toggle_button_text"
                android:backgroundTint="@drawable/toggle_button_background"
                android:fontFamily="@font/poppins"
                app:cornerRadius="24dp"
                app:strokeColor="@color/dark_background"
                app:strokeWidth="2dp"
                app:rippleColor="@color/light_background"/>
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llGender"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="@drawable/main_container"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toBottomOf="@id/llPool"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp">

        <TextView
            android:id="@+id/toggleGroupGenderLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pohlavie"
            android:textStyle="bold"
            android:textSize="16dp"
            android:textColor="@color/white"
            android:fontFamily="@font/poppins" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleGroupGender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonMuz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:text="Muž"
                android:textStyle="bold"
                android:textColor="@drawable/toggle_button_text"
                android:backgroundTint="@drawable/toggle_button_background"
                android:fontFamily="@font/poppins"
                app:cornerRadius="24dp"
                app:strokeColor="@color/dark_background"
                app:strokeWidth="2dp"
                app:rippleColor="@color/light_background"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonZena"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:text="Žena"
                android:textStyle="bold"
                android:textColor="@drawable/toggle_button_text"
                android:backgroundTint="@drawable/toggle_button_background"
                android:fontFamily="@font/poppins"
                app:cornerRadius="24dp"
                app:strokeColor="@color/dark_background"
                app:strokeWidth="2dp"
                app:rippleColor="@color/light_background"/>
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llStroke"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="@drawable/main_container"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toBottomOf="@id/llGender"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp">

        <TextView
            android:id="@+id/spinnerStrokeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Plavecký spôsob"
            android:textStyle="bold"
            android:fontFamily="@font/poppins"
            android:textColor="@color/white"
            android:textSize="16dp"
            android:gravity="center" />

        <Spinner
            android:id="@+id/spinnerStroke"
            android:layout_width="168dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/rounded_white_background"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:fontFamily="@font/poppins"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llDistance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="@drawable/main_container"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toBottomOf="@id/llStroke"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp">

        <TextView
            android:id="@+id/spinnerDistanceLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vzdialenosť"
            android:textStyle="bold"
            android:fontFamily="@font/poppins"
            android:textColor="@color/white"
            android:textSize="16dp"
            android:gravity="center"/>

        <Spinner
            android:id="@+id/spinnerDistance"
            android:layout_width="168dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/rounded_white_background"
            android:layout_marginHorizontal="6dp"
            android:gravity="center"
            android:fontFamily="@font/poppins"/>

    </LinearLayout>

    <TextView
        android:id="@+id/timeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/poppins"
        android:text="Čas:"
        android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llDistance" />

    <LinearLayout
        android:id="@+id/timeInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/timeLabel">

        <EditText
            android:id="@+id/minutes"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="mm"
            android:inputType="number"
            android:gravity="center"
            android:textColor="@android:color/black"
            android:textSize="20dp"
            android:textStyle="bold"
            android:background="@drawable/rounded_time"
            android:fontFamily="@font/poppins"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=":"
            android:textStyle="bold"
            android:textSize="20dp"
            android:fontFamily="@font/poppins_bold"/>

        <EditText
            android:id="@+id/seconds"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="ss"
            android:inputType="number"
            android:gravity="center"
            android:textColor="@android:color/black"
            android:textSize="20dp"
            android:textStyle="bold"
            android:background="@drawable/rounded_time"
            android:fontFamily="@font/poppins"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="."
            android:textStyle="bold"
            android:textSize="20dp"
            android:fontFamily="@font/poppins_bold"/>

        <EditText
            android:id="@+id/hundredths"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="ss"
            android:inputType="number"
            android:gravity="center"
            android:textColor="@android:color/black"
            android:textSize="20dp"
            android:textStyle="bold"
            android:background="@drawable/rounded_time"
            android:fontFamily="@font/poppins"/>
    </LinearLayout>

    <TextView
        android:id="@+id/pointsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="90dp"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/poppins"
        android:text="Body:"
        android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/timeInputLayout" />

    <EditText
        android:id="@+id/editTextPoints"
        android:layout_width="200dp"
        android:layout_height="56dp"
        android:hint="body"
        android:inputType="number"
        android:gravity="center"
        android:background="@drawable/rounded_points"
        android:textSize="20dp"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:fontFamily="@font/poppins"
        app:layout_constraintTop_toBottomOf="@id/pointsLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonCalculate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Vypočítať"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:backgroundTint="@color/dark_background"
        android:fontFamily="@font/poppins"
        app:cornerRadius="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/editTextPoints" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonClear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Vymaž"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:backgroundTint="@color/dark_background"
        android:fontFamily="@font/poppins"
        app:cornerRadius="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buttonCalculate" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonSaveToProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Ulož pokrok"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:backgroundTint="@color/dark_background"
        android:fontFamily="@font/poppins"
        app:cornerRadius="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buttonClear" />

</androidx.constraintlayout.widget.ConstraintLayout>