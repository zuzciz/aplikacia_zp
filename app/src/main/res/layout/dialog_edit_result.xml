<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="18dp"
    android:orientation="vertical"
    android:background="@color/log_reg_card"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/tvNewResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Upraviť výsledok"
        android:textColor="@color/title"
        android:textStyle="bold"
        android:textSize="30dp"
        android:fontFamily="@font/poppins_bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvD"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dátum: "
            android:textStyle="bold"
            android:fontFamily="@font/poppins" />

        <EditText
            android:id="@+id/eDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Dátum (dd.MM.yyyy)"
            android:textColor="#000000"
            android:layout_marginBottom="12dp"
            android:background="@color/white"
            android:padding="4dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvL"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dĺžka bazéna (m):"
            android:textStyle="bold"
            android:fontFamily="@font/poppins"/>

        <!--<EditText
            android:id="@+id/ePoolLength"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Dĺžka bazéna (m)"
            android:inputType="number"
            android:textColor="#000000"
            android:layout_marginBottom="12dp"
            android:background="@color/white"
            android:padding="4dp"/>-->
        <Spinner
            android:id="@+id/spinnerPoolLength"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:padding="4dp"
            android:background="@drawable/rounded_white_background" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvT"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Čas: "
            android:textStyle="bold"
            android:fontFamily="@font/poppins"/>

        <LinearLayout
            android:id="@+id/timeContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/white"
            android:layout_marginBottom="12dp">

            <EditText
                android:id="@+id/eMinutes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="min"
                android:inputType="number"
                android:gravity="center"/>

            <EditText
                android:id="@+id/eSeconds"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="sek"
                android:inputType="number"
                android:gravity="center"/>

            <EditText
                android:id="@+id/eHundredths"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="stotiny"
                android:inputType="number"
                android:gravity="center"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvP"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Body:"
            android:textStyle="bold"
            android:fontFamily="@font/poppins"/>

        <EditText
            android:id="@+id/ePoints"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Body"
            android:fontFamily="@font/poppins"
            android:inputType="number"
            android:padding="4dp"
            android:background="@color/white"
            android:textColor="#000000"
            android:layout_marginBottom="12dp"/>

        <CheckBox
            android:id="@+id/cbCompetitionE"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pretek"
            android:fontFamily="@font/poppins"
            android:buttonTint="@color/dark_background" />

        <EditText
            android:id="@+id/eEventName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Názov pretekov"
            android:fontFamily="@font/poppins"
            android:inputType="textCapSentences"
            android:padding="4dp"
            android:background="@color/white"
            android:textColor="#000000"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />
    </LinearLayout>

    <Button
        android:id="@+id/btnSubmit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Uložiť"
        android:backgroundTint="@color/dark_background"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:cornerRadius = "24dp"/>

</LinearLayout>