<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="18dp"
    android:orientation="vertical"
    android:background="@color/log_reg_card"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/tvNewResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nový výsledok"
        android:textColor="@color/title"
        android:textStyle="bold"
        android:textSize="30dp"
        android:fontFamily="@font/poppins_bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins"
            android:text="Dátum:"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Dátum (dd.MM.yyyy)"
            android:textColor="#000000"
            android:layout_marginBottom="12dp"
            android:background="@color/white"
            android:padding="4dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dĺžka bazéna (m):"
            android:textStyle="bold"
            android:fontFamily="@font/poppins" />

        <Spinner
            android:id="@+id/spinnerPoolLength"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:padding="4dp"
            android:background="@drawable/rounded_white_background" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Čas:"
            android:textStyle="bold"
            android:fontFamily="@font/poppins" />

        <LinearLayout
            android:id="@+id/timeContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/white"
            android:layout_marginBottom="12dp">

            <EditText
                android:id="@+id/etMinutes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="min"
                android:inputType="number"
                android:gravity="center"/>

            <EditText
                android:id="@+id/etSeconds"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="sek"
                android:gravity="center"
                android:inputType="number"/>

            <EditText
                android:id="@+id/etHundredths"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="stotiny"
                android:gravity="center"
                android:inputType="number" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Body:"
            android:textStyle="bold"
            android:fontFamily="@font/poppins"/>

        <EditText
            android:id="@+id/etPoints"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Body"
            android:fontFamily="@font/poppins"
            android:inputType="number"
            android:padding="4dp"
            android:background="@color/white"
            android:textColor="#000000"
            android:layout_marginBottom="12dp"/>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSubmit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Potvrdiť"
        android:backgroundTint="@color/dark_background"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:cornerRadius="24dp"
        android:fontFamily="@font/poppins"/>
</LinearLayout>